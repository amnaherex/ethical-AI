**Frontend Validation Before Upload:**
```javascript
const validateDataset = (file) => {
  // Check file type
  if (!file.name.endsWith('.csv')) {
    throw new Error('Only CSV files are supported');
  }

  // Check file size (max 100 MB)
  if (file.size > 100 * 1024 * 1024) {
    throw new Error('File size must not exceed 100 MB');
  }

  // Read first few rows to validate columns
  const reader = new FileReader();
  reader.onload = (e) => {
    const text = e.target.result;
    const firstLine = text.split('\n')[0];
    const columns = firstLine.split(',');

    // Check for required columns
    const hasTarget = columns.includes('y_true');
    const hasPrediction = columns.includes('y_pred');
    const hasSensitive = columns.some(col => 
      ['gender', 'race', 'age'].includes(col)
    );

    if (!hasTarget || !hasPrediction || !hasSensitive) {
      throw new Error(
        'CSV must include y_true, y_pred, and at least one sensitive attribute'
      );
    }
  };
  reader.readAsText(file.slice(0, 1024)); // Read first 1KB
};
```

**Error Codes:**
- 400: Invalid file format or missing required columns
- 413: File too large
- 422: CSV parsing error or data validation failed

